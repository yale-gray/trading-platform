# Copy to .env. No real broker keys: this project is simulation-only.
# Every key is optional; the value shown is the default used when the key is unset.
TRADEBOT_DB_PATH=./tradebot.db
TRADEBOT_CACHE_DIR=~/.tradebot/cache
TRADEBOT_API_HOST=127.0.0.1
TRADEBOT_API_PORT=8000
TRADEBOT_API_URL=http://127.0.0.1:8000
TRADEBOT_LOG_LEVEL=INFO
TRADEBOT_LOG_DIR=./logs
TRADEBOT_MAX_CATCHUP_BARS=400
TRADEBOT_EQUITY_CLOSE_DELAY_MIN=30
TRADEBOT_CHECKPOINT_KEEP=30
